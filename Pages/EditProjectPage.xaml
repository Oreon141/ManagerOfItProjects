<Page x:Class="ManagerOfItProjects.Pages.EditProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerOfItProjects.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с заголовком и кнопкой назад -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Редактирование проекта"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"/>

                <Button Content="← Назад"
                        Height="48"
                        Margin="25 0 0 0"
                        Padding="25 0"
                        FontSize="20"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <!-- Основная карточка с формой редактирования -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35"
                    Margin="0 25 0 0">
                <StackPanel>
                    <Grid Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка с основными полями -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Название проекта"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                            <TextBox x:Name="ProjectNameBox"
                                     Height="50"
                                     Margin="0 12 0 28"
                                     FontSize="18"
                                     Padding="12"
                                     Background="#f1f5f9"
                                     BorderBrush="#cbd5e1"
                                     BorderThickness="1"/>

                            <TextBlock Text="Описание"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                            <TextBox x:Name="DescriptionBox"
                                     Height="160"
                                     Margin="0 12 0 28"
                                     FontSize="18"
                                     Padding="12"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#f1f5f9"
                                     BorderBrush="#cbd5e1"/>
                        </StackPanel>

                        <!-- Правая колонка с дополнительными полями -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Приоритет"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                            <ComboBox x:Name="PriorityBox"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Height="50"
                                      Margin="0 12 0 28"
                                      FontSize="18"
                                      Background="#f1f5f9"
                                      BorderBrush="#cbd5e1"/>

                            <TextBlock Text="Дедлайн"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                            <DatePicker x:Name="DeadlinePicker"
                                        Height="50"
                                        Margin="0 12 0 28"
                                        FontSize="18"
                                        Background="#f1f5f9"
                                        BorderBrush="#cbd5e1"/>

                            <TextBlock Text="Статус"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                            <ComboBox x:Name="StatusBox"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Height="50"
                                      Margin="0 12 0 28"
                                      FontSize="18"
                                      Background="#f1f5f9"
                                      BorderBrush="#cbd5e1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопка сохранения изменений -->
                    <Button Content="Сохранить изменения"
                            Height="58"
                            Width="300"
                            HorizontalAlignment="Left"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>