<Page x:Class="ManagerOfItProjects.Pages.ProjectMembersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопкой назад и заголовком -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
            <Button Content="← Назад"
                    Width="120" 
                    Height="40"
                    Background="#2563eb" 
                    Foreground="White"
                    FontSize="18" 
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Back_Click"/>

            <TextBlock Text="Участники проекта"
                       Margin="20 0"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1e293b"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: список участников -->
            <Border Style="{StaticResource Card}" 
                    Padding="20" 
                    Margin="0 0 20 0">
                <StackPanel>
                    <TextBlock Text="Список участников"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0 0 0 20"/>

                    <!-- Панель фильтров -->
                    <StackPanel Orientation="Horizontal" 
                                Margin="0 0 0 15">
                        <!-- Поиск -->
                        <StackPanel Margin="0 0 15 0">
                            <TextBlock Text="Поиск"
                                       FontSize="16"
                                       Foreground="#475569"/>
                            <TextBox x:Name="SearchBox"
                                     Width="220"
                                     Height="36"
                                     FontSize="16"
                                     Padding="8"
                                     TextChanged="Filter_Changed"
                                     Background="#f1f5f9"
                                     BorderBrush="#cbd5e1"/>
                        </StackPanel>

                        <!-- Фильтр по роли -->
                        <StackPanel Margin="0 0 15 0">
                            <TextBlock Text="Фильтр по роли"
                                       FontSize="16"
                                       Foreground="#475569"/>
                            <ComboBox x:Name="RoleFilter"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Width="220"
                                      Height="36"
                                      FontSize="16"
                                      SelectionChanged="Filter_Changed"
                                      DisplayMemberPath="ProjectRoleName"
                                      Background="#f1f5f9"
                                      BorderBrush="#cbd5e1"/>
                        </StackPanel>

                        <!-- Кнопка сброса фильтров -->
                        <Button Content="Сбросить"
                                Width="120"
                                Height="38"
                                Background="#475569"
                                Foreground="White"
                                FontSize="16"
                                BorderThickness="0"
                                VerticalAlignment="Bottom"
                                Cursor="Hand"
                                Click="ResetFilters_Click"/>
                    </StackPanel>

                    <!-- Таблица участников -->
                    <DataGrid x:Name="MembersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              FontSize="18"
                              ColumnHeaderHeight="44"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              Background="Transparent"
                              AlternatingRowBackground="#f1f5f9"
                              HorizontalScrollBarVisibility="Disabled">

                        <!-- Стиль строк -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Колонки таблицы -->
                        <DataGrid.Columns>
                            <!-- ФИО -->
                            <DataGridTemplateColumn Header="ФИО" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}"
                                                   TextWrapping="Wrap"
                                                   FontSize="18"
                                                   Padding="4 6"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Роль -->
                            <DataGridTemplateColumn Header="Роль" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RoleName}"
                                                   TextWrapping="Wrap"
                                                   FontSize="18"
                                                   Padding="4 6"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Удаление -->
                            <DataGridTemplateColumn Header="Удалить" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить"
                                                Height="36"
                                                Padding="12 0"
                                                Background="#dc2626"
                                                Foreground="White"
                                                FontSize="16"
                                                BorderThickness="0"
                                                Tag="{Binding ProjectUserID}"
                                                Click="DeleteMember_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Правая часть: добавление участника -->
            <Border Grid.Column="1" 
                    Style="{StaticResource Card}" 
                    Padding="20"
                    x:Name="RightPanel">
                <StackPanel>
                    <TextBlock Text="Добавить участника"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0 0 0 20"/>

                    <TextBlock Text="Пользователь"
                               FontSize="16"
                               Margin="0 0 0 5"/>

                    <ComboBox x:Name="UserBox"
                              FontSize="18"
                              Height="42"
                              DisplayMemberPath="Surname"
                              SelectedValuePath="UserID"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Роль"
                               FontSize="16"
                               Margin="12 10 0 5"/>

                    <ComboBox x:Name="RoleBox"
                              FontSize="18"
                              Height="42"
                              DisplayMemberPath="ProjectRoleName"
                              SelectedValuePath="ProjectRoleID"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>

                    <Button Content="Добавить"
                            x:Name="AddMemberBtn"
                            Height="48" 
                            Width="180"
                            Margin="0 25 0 0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Background="#16a34a"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AddMember_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>