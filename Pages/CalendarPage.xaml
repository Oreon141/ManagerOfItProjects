<Page x:Class="ManagerOfItProjects.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="400"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0 0 0 10">
                    <Button x:Name="BtnPrevYear" 
                            Content="◄◄" 
                            Click="BtnPrevYear_Click"
                            FontSize="14"
                            Padding="8 4"
                            Width="40"
                            ToolTip="Предыдущий год"/>

                    <Button x:Name="BtnPrevMonth" 
                            Content="◄" 
                            Click="BtnPrevMonth_Click"
                            FontSize="14"
                            Padding="8 4"
                            Width="40"
                            Margin="10 0"
                            ToolTip="Предыдущий месяц"/>

                    <TextBlock x:Name="CurrentMonthText" 
                               Text="Текущий месяц"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               MinWidth="200"
                               TextAlignment="Center"
                               Margin="20 0"/>

                    <Button x:Name="BtnNextMonth" 
                            Content="►" 
                            Click="BtnNextMonth_Click"
                            FontSize="14"
                            Padding="8 4"
                            Width="40"
                            Margin="10 0"
                            ToolTip="Следующий месяц"/>

                    <Button x:Name="BtnNextYear" 
                            Content="►►" 
                            Click="BtnNextYear_Click"
                            FontSize="14"
                            Padding="8 4"
                            Width="40"
                            ToolTip="Следующий год"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0 10 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Пн" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Вт" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Ср" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Чт" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Пт" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="Сб" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Blue"/>
                    <TextBlock Grid.Column="6" Text="Вс" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Red"/>
                </Grid>

                <ItemsControl x:Name="CalendarDaysControl" Grid.Row="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    Margin="1"
                                    Background="{Binding BackgroundBrush}"
                                    CornerRadius="4">
                                <Button x:Name="DayButton"
                                        Content="{Binding DayNumber}"
                                        Click="DayButton_Click"
                                        Tag="{Binding Date}"
                                        FontSize="16"
                                        FontWeight="{Binding FontWeight}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        MinHeight="50"
                                        MinWidth="50"
                                        Padding="0"
                                        Background="{Binding DayBackground}"
                                        BorderThickness="0"
                                        Foreground="{Binding TextColor}">
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Padding="20"
                Margin="20 0 0 0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Дедлайны проектов"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SelectedDateText"
                           Grid.Row="1"
                           FontSize="18"
                           Margin="0 15 0 15"
                           TextWrapping="Wrap"
                           Foreground="#666"/>

                <ListView x:Name="EventsList"
                         Grid.Row="2"
                         FontSize="16"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8"
                                    Background="#F5F5F5"
                                    Margin="0 5"
                                    Padding="15 12"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#E3F2FD"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="📅"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10 0 0 0" Width="730">
                                        <TextBlock Text="{Binding ProjectName}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="18"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                            <TextBlock Text="Дедлайн: "
                                                       Foreground="#666"/>
                                            <TextBlock Text="{Binding FormattedDeadline}" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF5252"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                            <TextBlock Text="Приоритет: "
                                                       Foreground="#666"/>
                                            <TextBlock Text="{Binding Priority}" 
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0 8 0 0"
                                                   Foreground="#555"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>