<Page x:Class="ManagerOfItProjects.Pages.ProjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerOfItProjects.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с названием проекта и кнопкой назад -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <TextBlock x:Name="ProjectTitle"
                           Text="Проект"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>

                <Button Content="← Назад"
                        Height="48"
                        Margin="25 0 0 0"
                        Padding="25 0"
                        FontSize="20"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <!-- Карточка с детальной информацией о проекте -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35">
                <StackPanel>

                    <!-- Название проекта -->
                    <TextBlock Text="Название"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="NameText"
                               FontSize="20"
                               Margin="0 8 0 22"
                               Foreground="#1e293b"/>

                    <!-- Описание проекта -->
                    <TextBlock Text="Описание"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="DescriptionText"
                               FontSize="20"
                               TextWrapping="Wrap"
                               Margin="0 8 0 22"
                               Foreground="#1e293b"/>

                    <!-- Сетка с дополнительной информацией -->
                    <Grid Margin="0 10 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Приоритет"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="PriorityText"
                                       FontSize="20"
                                       Margin="0 8 0 22"
                                       Foreground="#1e293b"/>

                            <TextBlock Text="Статус"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="StatusText"
                                       FontSize="20"
                                       Margin="0 8 0 22"
                                       Foreground="#1e293b"/>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата начала"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="StartDateText"
                                       FontSize="20"
                                       Margin="0 8 0 22"
                                       Foreground="#1e293b"/>

                            <TextBlock Text="Дедлайн"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="DeadlineText"
                                       FontSize="20"
                                       Margin="0 8 0 22"
                                       Foreground="#1e293b"/>
                        </StackPanel>
                    </Grid>

                    <!-- Панель с кнопками действий -->
                    <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                        <Button Content="✎ Редактировать"
                                Height="48"
                                Width="200"
                                Margin="0 0 20 0"
                                Background="#2563eb"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Edit_Click"/>

                        <Button Content="🗒 Задачи"
                                Height="48"
                                Width="180"
                                Margin="0 0 20 0"
                                Background="#475569"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenTasks_Click"/>

                        <Button Content="👥 Участники"
                                Height="48"
                                Width="200"
                                Margin="0 0 20 0"
                                Background="#64748b"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenUsers_Click"/>

                        <Button Content="📊 Стадии"
                                Height="48"
                                Width="200"
                                Background="#64746b"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenStages_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>