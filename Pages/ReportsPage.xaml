<Page x:Class="ManagerOfItProjects.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Стиль для ячеек DataGrid с переносом текста и центрированием -->
        <Style x:Key="ReportDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="TextBlock.TextTrimming" Value="None"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для строк DataGrid -->
        <Style x:Key="ReportDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Стиль для заголовков столбцов -->
        <Style x:Key="ReportDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="Отчёты"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1e293b"
                   Margin="0 0 0 20"/>

        <!-- Карточка с фильтрами -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="20"
                Margin="0 0 0 20">
            <WrapPanel VerticalAlignment="Center" 
                       ItemWidth="300" 
                       MinWidth="600">
                <!-- Тип отчёта -->
                <StackPanel Margin="0 10 20 10">
                    <TextBlock Text="Тип отчёта" FontSize="16"/>
                    <ComboBox x:Name="ReportTypeCombo"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Width="250" 
                              Height="40" 
                              FontSize="16"
                              SelectionChanged="ReportTypeChanged"/>
                </StackPanel>

                <!-- Фильтр по проекту -->
                <StackPanel Margin="0 10 20 10" 
                            x:Name="ProjectFilterContainer" 
                            Visibility="Collapsed">
                    <TextBlock Text="Проект" FontSize="16"/>
                    <ComboBox x:Name="ProjectFilter"
                              Width="250" 
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              Height="40" 
                              FontSize="16"
                              DisplayMemberPath="ProjectName"/>
                </StackPanel>

                <!-- Кнопка генерации отчёта -->
                <Button Content="Сгенерировать"
                        Width="180" 
                        Height="40" 
                        FontSize="16"
                        Background="#2563eb"
                        Cursor="Hand"
                        Foreground="White"
                        Margin="20 22 0 0"
                        Click="GenerateReport_Click"/>
            </WrapPanel>
        </Border>

        <!-- Предварительный просмотр отчёта -->
        <Border Grid.Row="2" 
                Style="{StaticResource Card}" 
                Padding="20">
            <DataGrid x:Name="ReportGrid"
                      AutoGenerateColumns="True"
                      FontSize="16"
                      Background="Transparent"
                      AlternatingRowBackground="#eef3ff"
                      ColumnWidth="*"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      AutoGeneratingColumn="ReportGrid_AutoGeneratingColumn"
                      LoadingRow="ReportGrid_LoadingRow"
                      CellStyle="{StaticResource ReportDataGridCellStyle}"
                      RowStyle="{StaticResource ReportDataGridRowStyle}"
                      ColumnHeaderStyle="{StaticResource ReportDataGridColumnHeaderStyle}">

                <!-- Настройка скроллинга -->
                <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <!-- Кнопка сохранения -->
        <StackPanel Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Margin="0 15 0 0">
            <Button Content="Сохранить как DOCX"
            Width="200" 
            Height="40" 
            FontSize="16"
            Background="#475569"
            Cursor="Hand"
            Foreground="White"
            Margin="0 0 10 0"
            Click="SaveAsDocx_Click"/>

            <Button Content="Сохранить как Excel"
            Width="200" 
            Height="40" 
            FontSize="16"
            Background="#10b981"
            Cursor="Hand"
            Foreground="White"
            Click="SaveAsExcel_Click"/>
        </StackPanel>
    </Grid>
</Page>