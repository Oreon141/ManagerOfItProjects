<Page x:Class="ManagerOfItProjects.Pages.CreateProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с заголовком и кнопкой назад -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Создание проекта"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"/>

                <Button Content="← Назад"
                        HorizontalAlignment="Right"
                        Margin="20 0 0 0"
                        Width="140"
                        Height="45"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        Click="Back_Click"/>
            </StackPanel>

            <!-- Основная карточка с формой создания проекта -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="30"
                    Margin="0 20 0 0"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- Название проекта -->
                    <TextBlock Text="Название проекта" FontSize="18"/>
                    <TextBox x:Name="ProjectNameBox"
                             Height="45"
                             Margin="0 5 0 25"
                             FontSize="16"
                             Padding="10"
                             HorizontalAlignment="Stretch"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <!-- Описание проекта -->
                    <TextBlock Text="Описание" FontSize="18"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="140"
                             Margin="0 5 0 25"
                             FontSize="16"
                             Padding="10"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <!-- Приоритет и дедлайн в одной строке -->
                    <Grid Margin="0 5 0 25"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Приоритет проекта -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Приоритет" FontSize="18"/>
                            <ComboBox x:Name="PriorityBox"
                                      Cursor="Hand"
                                      Height="45"
                                      VerticalContentAlignment="Center"
                                      FontSize="16"
                                      Padding="8"
                                      Background="#f1f5f9"
                                      BorderBrush="#cbd5e1"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Дедлайн проекта -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дедлайн" FontSize="18"/>
                            <DatePicker x:Name="DeadlinePicker"
                                        Height="45"
                                        FontSize="16"
                                        Padding="6"
                                        Background="#f1f5f9"
                                        BorderBrush="#cbd5e1"
                                        HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <!-- Статус проекта -->
                    <TextBlock Text="Статус" FontSize="18"/>
                    <ComboBox x:Name="StatusBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="45"
                              Margin="0 5 0 35"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              HorizontalAlignment="Stretch"/>

                    <!-- Кнопка создания проекта -->
                    <Button Content="Создать проект"
                            Height="55"
                            Width="260"
                            FontSize="18"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Create_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>