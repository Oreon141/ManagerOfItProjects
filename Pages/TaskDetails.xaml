<Page x:Class="ManagerOfItProjects.Pages.TaskDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с кнопкой назад и заголовком -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <Button Content="← Назад"
                        Height="48"
                        Padding="30 0"
                        Background="#2563eb"
                        Foreground="White"
                        FontSize="20"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="Информация о задаче"
                           Margin="25 0"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>
            </StackPanel>

            <!-- Основная карточка с детальной информацией -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35">
                <StackPanel>
                    <!-- Название задачи -->
                    <TextBlock Text="Название"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               Margin="0 10 0 25"
                               TextWrapping="Wrap"
                               Foreground="#1e293b"/>

                    <!-- Описание задачи -->
                    <TextBlock Text="Описание"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="DescriptionText"
                               FontSize="20"
                               Margin="0 10 0 25"
                               TextWrapping="Wrap"
                               Foreground="#1e293b"/>

                    <!-- Проект -->
                    <TextBlock Text="Проект"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="ProjectText"
                               FontSize="20"
                               Margin="0 10 0 25"
                               Foreground="#1e293b"/>

                    <!-- Статус -->
                    <TextBlock Text="Статус"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="StatusText"
                               FontSize="20"
                               Margin="0 10 0 25"
                               Foreground="#1e293b"/>

                    <!-- Исполнитель -->
                    <TextBlock Text="Исполнитель"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="UserText"
                               FontSize="20"
                               Margin="0 10 0 25"
                               Foreground="#1e293b"/>

                    <!-- Кнопка редактирования -->
                    <Button Content="✎ Редактировать задачу"
                            x:Name="EditTaskButton"
                            Height="48"
                            Width="260"
                            Margin="0 20 0 0"
                            Background="#4f46e5"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="EditTask_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>