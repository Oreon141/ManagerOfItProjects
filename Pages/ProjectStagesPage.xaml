<Page x:Class="ManagerOfItProjects.Pages.ProjectStagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Стиль для раскрашивания текста статуса этапа -->
        <Style x:Key="StatusColorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <!-- Статус "не начат" - красный цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="не начат">
                    <Setter Property="Foreground" Value="#f87171"/>
                </DataTrigger>

                <!-- Статус "в процессе" - синий цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="в процессе">
                    <Setter Property="Foreground" Value="#60a5fa"/>
                </DataTrigger>

                <!-- Статус "выполнен" - зеленый цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="выполнен">
                    <Setter Property="Foreground" Value="#34d399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопка возврата на предыдущую страницу -->
        <Button Grid.Row="0"
                Content="← Назад"
                Width="120"
                Height="40"
                FontSize="16"
                Background="#475569"
                Foreground="White"
                Margin="0 0 0 10"
                HorizontalAlignment="Left"
                Click="BackButton_Click"/>

        <!-- Заголовок страницы -->
        <TextBlock Grid.Row="1"
                   Text="Этапы проекта"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1e293b"
                   Margin="0 0 0 20"/>

        <!-- Основной блок с таблицей этапов -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель фильтров и кнопок -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                    <!-- Поиск по названию и описанию -->
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Поиск" FontSize="16"/>
                        <TextBox x:Name="SearchBox"
                                 Width="240"
                                 Height="40"
                                 FontSize="16"
                                 Padding="8"
                                 TextChanged="FilterChanged"
                                 Background="#f1f5f9"
                                 BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <!-- Фильтр по статусу -->
                    <StackPanel>
                        <TextBlock Text="Статус" FontSize="16"/>
                        <ComboBox x:Name="StatusViewFilter"
                                  VerticalContentAlignment="Center"
                                  Cursor="Hand"
                                  Width="200"
                                  Height="40"
                                  FontSize="16"
                                  SelectionChanged="FilterChanged"
                                  Background="#f1f5f9"
                                  BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <!-- Кнопка сброса фильтров -->
                    <Button Content="Сбросить"
                            Width="120"
                            Height="40"
                            FontSize="16"
                            Cursor="Hand"
                            Margin="20 24 0 0"
                            Background="#475569"
                            Foreground="White"
                            Click="ResetFilters_Click"/>

                    <!-- Кнопка создания нового этапа -->
                    <Button Content="+ Создать"
                            x:Name="CreateStageBtn"
                            Width="120"
                            Height="40"
                            Cursor="Hand"
                            FontSize="16"
                            Margin="20 24 0 0"
                            Background="#3b82f6"
                            Foreground="White"
                            Click="AddStage_Click"/>
                </StackPanel>

                <!-- Таблица этапов проекта -->
                <DataGrid x:Name="StagesGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          FontSize="16"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          AlternatingRowBackground="#eef3ff"
                          ColumnHeaderHeight="45"
                          MouseDoubleClick="StagesGrid_MouseDoubleClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Margin="0 10 0 0">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Стиль заголовков колонок -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Background" Value="#f1f5f9"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Номер этапа -->
                        <DataGridTextColumn Header="Номер"
                                            Binding="{Binding StageNumber}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Название этапа -->
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding StageName}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Описание этапа -->
                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding StageDescription}"
                                            Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Плановое начало -->
                        <DataGridTextColumn Header="План. начало"
                                            Binding="{Binding PlannedStartDate, StringFormat=dd.MM.yyyy}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Плановый конец -->
                        <DataGridTextColumn Header="План. конец"
                                            Binding="{Binding PlannedEndDate, StringFormat=dd.MM.yyyy}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Статус с цветной подсветкой -->
                        <DataGridTemplateColumn Header="Статус" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Statuses.StatusName}"
                                               Style="{StaticResource StatusColorStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка с действиями -->
                        <DataGridTemplateColumn Header="Действия" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <Button Content="Открыть"
                                                Width="70" 
                                                Height="30"
                                                Margin="0 0 8 0"
                                                Background="#2563eb"
                                                Foreground="White"
                                                Tag="{Binding StageID}"
                                                Click="OpenStage_Click"/>

                                        <Button Content="🗑"
                                                Width="50" 
                                                Height="30"
                                                Background="#dc2626"
                                                Foreground="White"
                                                Tag="{Binding StageID}"
                                                Click="DeleteStage_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>