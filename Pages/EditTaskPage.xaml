<Page x:Class="ManagerOfItProjects.Pages.EditTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerOfItProjects.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с заголовком и кнопкой назад -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <TextBlock Text="Редактирование задачи"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"/>

                <Button Content="← Назад"
                        Height="48"
                        Padding="30 0"
                        Margin="25 0 0 0"
                        Background="#475569"
                        Foreground="White"
                        FontSize="20"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <!-- Основная карточка с формой редактирования -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35">
                <StackPanel Width="650">

                    <!-- Название задачи -->
                    <TextBlock Text="Название задачи"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBox x:Name="TaskNameBox"
                             Height="58"
                             Margin="0 10 0 25"
                             FontSize="20"
                             Padding="12"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"
                             BorderThickness="1"/>

                    <!-- Описание задачи -->
                    <TextBlock Text="Описание"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="120"
                             Margin="0 10 0 25"
                             FontSize="20"
                             Padding="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"
                             BorderThickness="1"/>

                    <!-- Статус задачи -->
                    <TextBlock Text="Статус"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <ComboBox x:Name="StatusBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="48"
                              Margin="0 10 0 25"
                              FontSize="20"
                              Padding="8"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              DisplayMemberPath="StatusName"/>

                    <!-- Исполнитель задачи -->
                    <TextBlock Text="Исполнитель"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <ComboBox x:Name="UserBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="48"
                              Margin="0 10 0 25"
                              FontSize="20"
                              Padding="8"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              DisplayMemberPath="Login"/>

                    <!-- Приоритет задачи -->
                    <TextBlock Text="Приоритет"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <ComboBox x:Name="PriorityBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="48"
                              Margin="0 10 0 35"
                              FontSize="20"
                              Padding="8"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>

                    <!-- Кнопка сохранения изменений -->
                    <Button Content="Сохранить изменения"
                            Height="52"
                            Width="290"
                            Margin="0 10 0 0"
                            Background="#2563eb"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>