<Page x:Class="ManagerOfItProjects.Pages.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">
    <Page.Resources>
        <!-- Стиль для раскрашивания текста статуса -->
        <Style x:Key="StatusColorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- Статус "не начат" - красный цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="не начат">
                    <Setter Property="Foreground" Value="#f87171"/>
                </DataTrigger>

                <!-- Статус "в процессе" - синий цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="в процессе">
                    <Setter Property="Foreground" Value="#60a5fa"/>
                </DataTrigger>

                <!-- Статус "выполнен" - зеленый цвет -->
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="выполнен">
                    <Setter Property="Foreground" Value="#34d399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Margin="0 0 0 20">
            <TextBlock Text="Все проекты"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1e293b"/>
        </StackPanel>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0 0 0 10">
            <Button Content="Создать проект"
                    x:Name="CreateProjectButton"
                    Width="180"
                    Height="40"
                    Cursor="Hand"
                    FontSize="16"
                    Background="#3b82f6"
                    Foreground="White"
                    Margin="0 0 10 0"
                    Click="CreateProject_Click"/>
        </StackPanel>

        <!-- Основная карточка с таблицей проектов -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель фильтров -->
                <WrapPanel Margin="0 0 0 15">
                    <!-- Поиск по названию и описанию -->
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Поиск"
                                   FontSize="16"
                                   Margin="0 0 0 4"/>
                        <TextBox x:Name="SearchBox"
                                 Width="220"
                                 Height="40"
                                 FontSize="16"
                                 Padding="8"
                                 Background="#f1f5f9"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- Фильтр по статусу -->
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Статус"
                                   FontSize="16"
                                   Margin="0 0 0 4"/>
                        <ComboBox x:Name="StatusFilter"
                                  VerticalContentAlignment="Center"
                                  Cursor="Hand"
                                  Width="200"
                                  Height="40"
                                  FontSize="16"
                                  Background="#f1f5f9"
                                  BorderBrush="#cbd5e1"
                                  SelectionChanged="FilterChanged"
                                  DisplayMemberPath="StatusName"
                                  SelectedValuePath="StatusID"/>
                    </StackPanel>

                    <!-- Фильтр по приоритету -->
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Приоритет"
                                   FontSize="16"
                                   Margin="0 0 0 4"/>
                        <ComboBox x:Name="PriorityFilter"
                                  VerticalContentAlignment="Center"
                                  Cursor="Hand"
                                  Width="200"
                                  Height="40"
                                  FontSize="16"
                                  Background="#f1f5f9"
                                  BorderBrush="#cbd5e1"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- Кнопка сброса фильтров -->
                    <Button Content="Сбросить"
                            Width="120"
                            Height="40"
                            Cursor="Hand"
                            FontSize="16"
                            Background="#475569"
                            Foreground="White"
                            Margin="10 24 0 0"
                            Click="ResetFilters_Click"/>
                </WrapPanel>

                <!-- Таблица проектов -->
                <DataGrid x:Name="ProjectsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          Cursor="Hand"
                          IsReadOnly="True"
                          FontSize="16"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          AlternatingRowBackground="#eef3ff"
                          ColumnHeaderHeight="45"
                          Margin="0 10 0 0"
                          LoadingRow="ProjectsGrid_LoadingRow"
                          AutoGeneratingColumn="ProjectsGrid_AutoGeneratingColumn"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="ProjectsGrid_MouseDoubleClick">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Стиль заголовков колонок -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Background" Value="#f1f5f9"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Название проекта -->
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding ProjectName}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Описание проекта -->
                        <DataGridTextColumn Header="Описание"
                                            Binding="{Binding Description}"
                                            Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Дата начала -->
                        <DataGridTextColumn Header="Дата начала"
                                            Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}"
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Дедлайн -->
                        <DataGridTextColumn Header="Дедлайн"
                                            Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Приоритет -->
                        <DataGridTextColumn Header="Приоритет"
                                            Binding="{Binding Priority}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Статус с цветной подсветкой -->
                        <DataGridTemplateColumn Header="Статус" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Statuses.StatusName}"
                                               Style="{StaticResource StatusColorStyle}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка с действиями -->
                        <DataGridTemplateColumn Header="Действия" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <Button Content="Открыть"
                                                Width="70" 
                                                Height="30"
                                                Margin="0 0 8 0"
                                                Background="#2563eb"
                                                Foreground="White"
                                                Tag="{Binding ProjectID}"
                                                Click="OpenProject_Click"/>

                                        <Button Content="🗑"
                                                Width="50" 
                                                Height="30"
                                                Background="#dc2626"
                                                Foreground="White"
                                                Tag="{Binding ProjectID}"
                                                Click="DeleteProject_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>