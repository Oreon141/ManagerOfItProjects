<Page x:Class="ManagerOfItProjects.Pages.CreateTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с заголовком и кнопкой назад -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Создание задачи"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>

                <Button Content="← Назад"
                        Width="140"
                        Height="45"
                        Margin="20 0 0 0"
                        FontSize="16"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <!-- Форма создания задачи -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="30"
                    Margin="0 20 0 0"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- Название задачи -->
                    <TextBlock Text="Название задачи" FontSize="18"/>
                    <TextBox x:Name="TaskNameBox"
                             Height="45"
                             Margin="0 5 0 25"
                             Padding="10"
                             FontSize="16"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"
                             HorizontalAlignment="Stretch"/>

                    <!-- Описание задачи -->
                    <TextBlock Text="Описание" FontSize="18"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="140"
                             Padding="10"
                             Margin="0 5 0 25"
                             FontSize="16"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"
                             HorizontalAlignment="Stretch"/>

                    <!-- Статус задачи -->
                    <TextBlock Text="Статус" FontSize="18"/>
                    <ComboBox x:Name="StatusBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="50"
                              Margin="0 5 0 25"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              HorizontalAlignment="Stretch"/>

                    <!-- Исполнитель задачи -->
                    <TextBlock Text="Исполнитель" FontSize="18"/>
                    <ComboBox x:Name="UserBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="50"
                              Margin="0 5 0 35"
                              FontSize="16"
                              DisplayMemberPath="Login"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              HorizontalAlignment="Stretch"/>

                    <!-- Кнопка создания задачи -->
                    <Button Content="Создать задачу"
                            Height="55"
                            Width="260"
                            FontSize="18"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Create_Click"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>