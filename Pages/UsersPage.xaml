<Page x:Class="ManagerOfItProjects.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded"
      SizeChanged="Page_SizeChanged">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="Управление пользователями"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#1e293b"
                   Margin="0 0 0 20"/>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: список пользователей -->
            <Border Style="{StaticResource Card}" 
                    Padding="20" 
                    Margin="0 0 20 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фильтр по роли и кнопка сброса -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                        <!-- Фильтр по роли -->
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Роль" 
                                       FontSize="18" 
                                       Margin="0 0 0 4"/>
                            <ComboBox x:Name="RoleFilter"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"
                                      Width="200"
                                      Height="40"
                                      FontSize="16"
                                      Background="#f1f5f9"
                                      BorderBrush="#cbd5e1"
                                      SelectionChanged="RoleFilter_SelectionChanged"
                                      DisplayMemberPath="RoleName"/>
                        </StackPanel>

                        <!-- Кнопка сброса фильтров и выбора -->
                        <StackPanel Margin="0 30 0 0">
                            <Button Content="Сбросить выбор"
                                    Width="200"
                                    Height="40"
                                    FontSize="16"
                                    Cursor="Hand"
                                    Background="#64748b"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="ResetSelection_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Таблица пользователей -->
                    <DataGrid x:Name="UsersGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              Cursor="Hand"
                              IsReadOnly="True"
                              FontSize="16"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              AlternatingRowBackground="#eef3ff"
                              ColumnHeaderHeight="45"
                              LoadingRow="UsersGrid_LoadingRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Margin="0 10 0 0"
                              SelectionChanged="UsersGrid_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="45"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- ID пользователя -->
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding UserID}" 
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Фамилия -->
                            <DataGridTextColumn Header="Фамилия" 
                                                Binding="{Binding Surname}" 
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Имя -->
                            <DataGridTextColumn Header="Имя" 
                                                Binding="{Binding FirstName}" 
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Отчество -->
                            <DataGridTextColumn Header="Отчество" 
                                                Binding="{Binding LastName}" 
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Email -->
                            <DataGridTextColumn Header="Email" 
                                                Binding="{Binding Email}" 
                                                Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Логин -->
                            <DataGridTextColumn Header="Логин" 
                                                Binding="{Binding Login}" 
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Роль -->
                            <DataGridTextColumn Header="Роль" 
                                                Binding="{Binding UserRoles.RoleName}" 
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Правая панель: редактирование пользователя -->
            <Border Grid.Column="1" 
                    Style="{StaticResource Card}" 
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Редактирование пользователя"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0 0 0 20"/>

                        <!-- Поля с валидацией -->
                        <TextBlock Text="Фамилия" FontSize="18"/>
                        <TextBox x:Name="SurnameBox"
                                 Height="40" 
                                 FontSize="16"
                                 Margin="0 0 0 10"
                                 Padding="8"
                                 Background="#f8fafc"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="ValidateFields"/>
                        <TextBlock x:Name="SurnameError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -5 0 10"/>

                        <TextBlock Text="Имя" FontSize="18"/>
                        <TextBox x:Name="FirstNameBox"
                                 Height="40" 
                                 FontSize="16"
                                 Margin="0 0 0 10"
                                 Padding="8"
                                 Background="#f8fafc"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="ValidateFields"/>
                        <TextBlock x:Name="FirstNameError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -5 0 10"/>

                        <TextBlock Text="Отчество" FontSize="18"/>
                        <TextBox x:Name="LastNameBox"
                                 Height="40" 
                                 FontSize="16"
                                 Margin="0 0 0 10"
                                 Padding="8"
                                 Background="#f8fafc"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="ValidateFields"/>

                        <TextBlock Text="Email" FontSize="18"/>
                        <TextBox x:Name="EmailBox"
                                 Height="40" 
                                 FontSize="16"
                                 Margin="0 0 0 10"
                                 Padding="8"
                                 Background="#f8fafc"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="ValidateFields"/>
                        <TextBlock x:Name="EmailError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -5 0 10"/>

                        <TextBlock Text="Логин" FontSize="18"/>
                        <TextBox x:Name="LoginBox"
                                 Height="40" 
                                 FontSize="16"
                                 Margin="0 0 0 10"
                                 Padding="8"
                                 Background="#f8fafc"
                                 BorderBrush="#cbd5e1"
                                 TextChanged="ValidateFields"/>
                        <TextBlock x:Name="LoginError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -5 0 10"/>

                        <TextBlock Text="Пароль" FontSize="18"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="40"
                                     FontSize="18"
                                     Margin="0 0 0 10"
                                     Padding="8"
                                     Background="#f8fafc"
                                     BorderBrush="#cbd5e1"
                                     PasswordChanged="ValidateFields"/>
                        <TextBlock x:Name="PasswordError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -5 0 10"/>

                        <TextBlock Text="Роль" FontSize="18"/>
                        <ComboBox x:Name="RoleBox"
                                  Height="40"
                                  Margin="0 0 0 20"
                                  FontSize="16"
                                  Padding="8"
                                  DisplayMemberPath="RoleName"
                                  Background="#f8fafc"
                                  BorderBrush="#cbd5e1"
                                  SelectionChanged="ValidateFields"/>
                        <TextBlock x:Name="RoleError" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   Visibility="Collapsed" 
                                   Margin="0 -15 0 10"/>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" 
                                    Margin="0 20 0 0" 
                                    HorizontalAlignment="Center">
                            <Button Content="Создать"
                                    Width="110" 
                                    Height="42"
                                    FontSize="17"
                                    Background="#2563eb"
                                    Foreground="White"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Click="CreateUser_Click"
                                    x:Name="CreateButton"/>

                            <Button Content="Сохранить"
                                    Width="120" 
                                    Height="42"
                                    Margin="10 0"
                                    Cursor="Hand"
                                    FontSize="17"
                                    Background="#16a34a"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="SaveUser_Click"
                                    x:Name="SaveButton"/>

                            <Button Content="Удалить"
                                    Width="110" 
                                    Height="42"
                                    Cursor="Hand"
                                    FontSize="17"
                                    Background="#dc2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="DeleteUser_Click"
                                    x:Name="DeleteButton"/>
                        </StackPanel>

                        <!-- Сводка ошибок валидации -->
                        <TextBlock x:Name="ValidationSummary" 
                                   Foreground="Red" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   Margin="0 15 0 0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>